# claude-launcher — spawns remote-controlled `claude` sessions on this host.
# Copy to .env and edit. Real environment variables always win over this file.

# CLAUDE_LAUNCHER_PORT=8922

# Hostname shown in the startup banner (cosmetic; the server always binds 0.0.0.0).
# CLAUDE_LAUNCHER_HOST=localhost

# Absolute path to the `claude` binary, if it isn't on PATH for the shells you
# launch (e.g. a non-standard install). Default: "claude".
# CLAUDE_BIN=

# Directory pre-filled in the UI's new-session form, for convenience.
# CLAUDE_LAUNCHER_DEFAULT_DIR=/Users/you/dev

# Where session logs and recents.json live. Default: ./data next to the binary.
# CLAUDE_LAUNCHER_DATA_DIR=

# The catalog (model dropdown + known shells). Default: config.yaml in the
# working directory, else next to the binary, else the built-in defaults.
# Generate a starting point with: claude-launcher --dump-config > config.yaml
# CLAUDE_LAUNCHER_CONFIG=/etc/claude-launcher/config.yaml

# ── Ring (multi-host) ────────────────────────────────────────────────────────
# One UI can drive launchers on several machines. Membership is a STATIC,
# hand-maintained ring — no election, no discovery. A leader fans out to its
# followers; each node owns (and is the sole authority for) its own live
# sessions. Defaults make a lone instance a leader-of-itself.
#
# CLAUDE_LAUNCHER_ROLE=leader          # or: follower
# CLAUDE_LAUNCHER_NODE_ID=laptop       # stable routing key, unique in the ring
# CLAUDE_LAUNCHER_NODE_LABEL=Laptop    # optional pretty name shown in the UI
#
# Leader only — the follower list, as id|label|url,id|label|url:
# CLAUDE_LAUNCHER_FOLLOWERS=desktop|Desktop|http://desktop.example.ts.net:8922
#
# A follower needs only ROLE + NODE_ID; it serves its own local API.
